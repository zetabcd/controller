diff --git a/src/modules/commander/ekf_restart.h b/src/modules/commander/ekf_restart.h
new file mode 100644
--- /dev/null
+++ b/src/modules/commander/ekf_restart.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include <cstdint>
+
+namespace many_controller {
+// Project-private 32-bit DDS command, not MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN.
+// param1: ASCII "EKF" key; param2: integer sequence 1..16777215.
+// The final ACK echoes param2 in result_param2. No estimator change while armed.
+static constexpr uint32_t kEkfRestartCommand = 100010;
+static constexpr float kEkfRestartKey = 4541254.0F;
+}
