<?xml version="1.0"?>
<package format="3">
  <name>flight_data_recorder</name>
  <version>0.1.0</version>
  <description>ROS 2 numeric flight-data recording to PlotJuggler-compatible ULog.</description>
  <maintainer email="orion@todo.todo">orion</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>uav_utils</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>rosidl_parser</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>px4debug_msgs</exec_depend>
  <exec_depend>ratectrl_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
