<?xml version="1.0"?>
<package format="3">
  <name>gap_planner</name><version>0.1.0</version>
  <description>GCOPTER SE3 gap planning from rigid-body motion capture or configured simulation gates.</description>
  <maintainer email="sun@example.com">sun</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>geometry_msgs</depend><depend>visualization_msgs</depend>
  <depend>std_msgs</depend><depend>gap_msgs</depend><depend>px4ctrl</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>quadsim_mujoco</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
