Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world_nwu
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
    - Class: rviz_default_plugins/MarkerArray
      Name: Gates and planned body envelopes
      Enabled: true
      Topic:
        Value: /gap/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Pitch: 0.45
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
